# Copie para .env e ajuste os valores. Nunca versione o .env real.

# PostgreSQL
POSTGRES_USER=chamados
POSTGRES_PASSWORD=change-me
POSTGRES_DB=chamados
POSTGRES_PORT=5432
API_PORT=8000

# JWT. Gere um segredo com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-random-secret-with-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Admin criado na inicialização da API, se o e-mail ainda não existir
FIRST_ADMIN_NAME=Administrator
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=change-me-admin

# Usados ao rodar alembic/uvicorn/pytest fora do Docker (a partir de backend/).
# O banco de teste é criado automaticamente pela suíte de testes.
DATABASE_URL=postgresql+asyncpg://chamados:change-me@localhost:5432/chamados
TEST_DATABASE_URL=postgresql+asyncpg://chamados:change-me@localhost:5432/chamados_test
